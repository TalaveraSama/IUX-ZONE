# Node.js 22+: node --env-file=.env server.js
PORT=3000
DATA_DIR=./data
# Required in production (12+ characters). Set your own unique password.
ADMIN_PASSWORD=
# Enable only behind an HTTPS reverse proxy; production sessions use Secure cookies.
# NODE_ENV=production

# Bind address; installer uses 127.0.0.1 by default.
HOST=0.0.0.0
# Playback-only shared secret (24+ characters); never use ADMIN_PASSWORD here.
STREAM_TOKEN=
# Public origin for exported relay links, e.g. https://tv.example.com
PUBLIC_URL=
# Optional local IPv4 for joining UDP/RTP multicast groups.
MULTICAST_INTERFACE=
